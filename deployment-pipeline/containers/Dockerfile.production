# Stage 1: Build the application using Node.js 22
FROM node:22-alpine AS build

WORKDIR /app

COPY kijanikiosk-payments/package*.json ./
RUN npm ci

COPY kijanikiosk-payments/src ./src
COPY kijanikiosk-payments/scripts ./scripts

RUN npm run build


# Stage 2: Minimal production runtime
FROM alpine:3.24 AS production

# Install only the Node.js runtime and create the application user
RUN apk add --no-cache nodejs \
    && addgroup -S kijani \
    && adduser -S -G kijani kijani

WORKDIR /app

COPY --from=build --chown=kijani:kijani /app/dist ./dist
COPY --from=build --chown=kijani:kijani /app/package.json ./package.json

USER kijani

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]
